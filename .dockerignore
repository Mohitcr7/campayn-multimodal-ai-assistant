# .dockerignore — files excluded from the Docker build context
#
# Docker sends all files in the build context to the Docker daemon.
# Excluding large/sensitive files makes builds faster and images smaller.

# Python cache — never needed inside container
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.eggs/

# Data files.
# data/raw (4.8MB creator CSV + knowledge base) and data/vector_store (18MB
# ChromaDB index) ARE baked into the image — 22MB total, not the 500MB an
# earlier comment here claimed. They have to be in the image for Kubernetes:
# unlike docker-compose, the k8s pods mount no host volume, so without this
# the API starts with zero creator profiles and no vector store.
# docker-compose still bind-mounts ./data over the top for live edits.
data/processed/

# Logs — generated at runtime
logs/

# Git history — not needed in the image
.git/
.gitignore

# Dev files
.env             # NEVER bake .env into the image — it has secret keys
.env.*
!.env.example    # except the example (has no real keys)
notebooks/
*.ipynb
.ipynb_checkpoints/

# Tests — not needed in production container
tests/

# IDE
.vscode/
.idea/
*.swp
.DS_Store